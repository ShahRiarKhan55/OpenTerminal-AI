# OpenTerminal configuration template. Full descriptions: docs/CONFIGURATION.md
#
# The server does NOT read .env files itself (no dotenv): only Docker Compose substitutes them.
# For plain `npm run`, export the variables in your shell. Never commit a real `.env` (git-ignored).
# Nothing here is required for local use. Empty values mean "use the default".

# ---- Safety (fixed) ---------------------------------------------------------
# The ONLY accepted value is "paper". Anything else stops the worker at startup.
# Live brokerage execution is not implemented and cannot be enabled.
TRADING_MODE=paper

# ---- API security -----------------------------------------------------------
# Shared secret for every non-market endpoint. If unset, one is generated into data/.api-key.
# Set explicitly (same value on api AND web) for anything reachable beyond localhost.
API_KEY=
API_KEY_FILE=
# Browser origin allowed to call the API (CORS).
WEB_ORIGIN=http://localhost:3000
# Keep 127.0.0.1 unless you are deliberately exposing the API.
API_HOST=127.0.0.1
API_PORT=4000
# Where the web proxy reaches the API.
API_URL=http://localhost:4000
# Extra hostnames the dashboard may be served from (comma-separated, no ports). localhost and
# 127.0.0.1 are always allowed; every other Host header is refused (DNS-rebinding defence).
ALLOWED_HOSTS=
# Set to 1 ONLY behind exactly one trusted reverse proxy.
TRUST_PROXY=
# SQLite directory (api and worker must share it). Default: ./data
DATA_DIR=

# ---- Outbound identity to data providers ------------------------------------
# SET THIS to your own email: SEC EDGAR requires a contact. The built-in fallback is the upstream
# project author's address, so leaving it unset means your traffic names them.
SEC_EDGAR_CONTACT=
# Pin one Yahoo User-Agent instead of a random pick per process (optional).
YAHOO_USER_AGENT=

# ---- Market data freshness (alert / paper-trade eligibility) ----------------
# Public data is delayed or indicative. These bound how old a price may be before it is refused for
# ALERTS and PAPER TRADES (display is unaffected). Invalid values fall back to the defaults.
MAX_QUOTE_AGE_SEC=120
MAX_DELAYED_AGE_SEC=1200
# Only the literal "true" allows pre-market / after-hours alerts.
ALERT_ALLOW_EXTENDED_HOURS=false
MAX_CANDLE_LAG_SEC=900

# ---- Monitoring worker ------------------------------------------------------
MONITOR_POLL_SECONDS=60
MONITOR_IDLE_POLL_SECONDS=300
MONITOR_CANDLE_REFRESH_SECONDS=300
MONITOR_DAILY_REFRESH_SECONDS=3600
MONITOR_MAX_SYMBOLS=40
MONITOR_NEWS_ENABLED=true
MONITOR_NEWS_REFRESH_SECONDS=900
ALERT_DAILY_CAP=60
DATA_RETENTION_DAYS=90
# Starting paper cash (applied when the database is first created).
PAPER_STARTING_CASH=100000
LOG_LEVEL=info

# ---- Telegram notifications (optional; outbound only) -----------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
TELEGRAM_MIN_IMPORTANCE=normal
TELEGRAM_DAILY_CAP=40
TELEGRAM_API_BASE=

# ---- AI (optional; event-triggered with a hard daily budget) ----------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
AI_MODEL=
AI_ENABLED=true
AI_DAILY_CALL_LIMIT=10
AI_MAX_TOKENS=500
AI_MIN_INTERVAL_SEC=30
AI_TIMEOUT_MS=30000
AI_MIN_IMPORTANCE=normal
