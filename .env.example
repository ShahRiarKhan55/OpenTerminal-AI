# OpenTerminal configuration reference. Copy to `.env` for Docker Compose, or
# export the variables in your shell. The server does NOT read .env files by
# itself (no dotenv) -- only Docker Compose substitutes them. Never commit a
# real `.env`; it is git-ignored. No variable below is required for local use.

# ---- AI assistant (optional) ------------------------------------------------
ANTHROPIC_API_KEY=
# Override the model id (default is set in server/src/routes/ai.ts).
ANTHROPIC_MODEL=
# Anthropic-compatible gateway instead of api.anthropic.com.
ANTHROPIC_BASE_URL=

# ---- API security -----------------------------------------------------------
# Shared secret for /api/portfolios and /api/ai. If unset, one is generated
# into data/.api-key on first run. Set explicitly (same value on api AND web)
# for anything reachable beyond localhost.
API_KEY=
# Browser origin allowed to call the API (CORS).
WEB_ORIGIN=http://localhost:3000
# Bind address. Keep 127.0.0.1 unless you are deliberately exposing the API.
API_HOST=127.0.0.1
API_PORT=4000
# Set to 1 ONLY behind exactly one trusted reverse proxy (see README).
TRUST_PROXY=

# ---- Storage ----------------------------------------------------------------
# SQLite directory (default: ./data).
DATA_DIR=

# ---- Web -> API proxy (web process) -----------------------------------------
API_URL=http://localhost:4000
# Path to the generated key file, if API_KEY is not set on the web process.
API_KEY_FILE=

# ---- Outbound identity to data providers ------------------------------------
# SEC EDGAR requires requests to identify a contact. SET THIS to your own email:
# the built-in fallback is the upstream project author's address (see
# server/src/providers/secedgar.ts), so unset means your traffic names them.
SEC_EDGAR_CONTACT=
# Pin one Yahoo User-Agent instead of a random pick per process (optional).
YAHOO_USER_AGENT=

# ---- Market data freshness (alert eligibility) ------------------------------
# Public endpoints are delayed or indicative, never exchange-grade. These bound
# how old a price may be before it is refused for ALERT generation (display is
# unaffected). Invalid or non-positive values fall back to the defaults.
# Max age in seconds of a provider-declared real-time print.
MAX_QUOTE_AGE_SEC=120
# Max age in seconds of a delayed/indicative print (~15 min delay + slack).
MAX_DELAYED_AGE_SEC=1200
# Alerts only fire while the primary session is open. Set to "true" to also
# allow pre-market / after-hours prints. Any other value keeps this off.
ALERT_ALLOW_EXTENDED_HOURS=false
